{
  "name": "server",
  "version": "0.0.0",
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1.0",
    "@aws-sdk/types": "^3.1.0",
    "@koa/cors": "^3.1.0",
    "@types/koa": "^2.11.6",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-logger": "^3.1.1",
    "@types/koa-router": "^7.4.1",
    "@types/koa__cors": "^3.0.2",
    "dotenv": "^8.2.0",
    "koa": "^2.13.0",
    "koa-bodyparser": "^4.3.0",
    "koa-logger": "^3.2.1",
    "koa-router": "^10.0.0",
    "mongoose": "^5.11.8",
    "nodemon": "^2.0.6",
    "ts-node": "^9.1.1",
    "typescript": "^4.1.3"
  },
  "scripts": {
    "start": "yarn build && node -r dotenv/config build/index.js",
    "watch": "nodemon -r dotenv/config --exec ts-node src/index.ts",
    "local-start": "yarn build && DOTENV_CONFIG_LOCALDB=1 node -r dotenv/config build/index.js",
    "local-watch": "DOTENV_CONFIG_LOCALDB=1 nodemon -r dotenv/config build/index.js",
    "build": "tsc && echo \"Compile Completed!\nServer will run on http://localhost:3885\""
  }
