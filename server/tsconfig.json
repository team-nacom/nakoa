{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "#/*": ["./*"],
      "#common/*": ["./common/*"] // symlink
    },
    "esModuleInterop": true,
    "outDir": "build",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": []
}