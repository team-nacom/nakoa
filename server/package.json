{
  "name": "server",
  "version": "0.0.0",
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "@types/koa": "^2.11.6",
    "@types/koa-logger": "^3.1.1",
    "@types/koa-router": "^7.4.1",
    "dotenv": "^8.2.0",
    "koa": "^2.13.0",
    "koa-logger": "^3.2.1",
    "koa-router": "^10.0.0",
    "mongoose": "^5.11.8",
    "nodemon": "^2.0.6",
    "ts-node": "^9.1.1",
    "typescript": "^4.1.3"
  },
  "scripts": {
    "start": "tsc && echo \"Compile Completed!\nServer running on http://localhost:3885\" && node build/index.js",
    "watch": "nodemon --exec ts-node src/index.ts",
    "local-start": "tsc && DOTENV_CONFIG_LOCALDB=1 node -r dotenv build/index.js",
    "local-watch": "DOTENV_CONFIG_LOCALDB=1 nodemon -r dotenv build/index.js",
    "build": "tsc"
  }
}
