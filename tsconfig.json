{
    "compilerOptions": {
        "module": "esnext",
        "target": "es5",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "strict": true,
        "baseUrl": "./src",
        "paths": {
            "#/*": ["*"]
        },
        "allowJs": true,
        "jsx": "preserve",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "removeComments": true,
        "plugins": [{ "name": "typescript-plugin-css-modules" }]
    },
    "include": [
        "src"
    ]
}
