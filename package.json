{
    "name": "nakoa",
    "version": "0.1.0",
    "private": "true",
    "scripts": {
        "install-all": "yarn && yarn --cwd ./client/ && yarn --cwd ./server/",
        "build-all": "yarn install-all && yarn --cwd ./client/ build && yarn --cwd ./server/ build",
        "watch-client": "yarn --cwd ./client/ watch",
        "start-server": "yarn --cwd ./server/ watch",
        "watch": "concurrently --kill-others -n \"CLIENT,SERVER\" \"yarn watch-client\" \"yarn start-server\"",
        "build-client": "yarn --cwd ./client/ build",
        "build-server": "yarn --cwd ./server/ build",
        "build": "yarn build-client && yarn build-server"
    },
    "devDependencies": {
        "concurrently": "^5.3.0",
        "ansi-regex": "^5.0.1"
    }
}
