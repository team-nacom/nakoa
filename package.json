{
    "name": "nakoa",
    "version": "0.1.0",
    "private": "true",
    "scripts": {
        "install": "yarn --cwd ./client/ && yarn --cwd ./server/",
        "client": "yarn --cwd ./client/ watch",
        "server": "yarn --cwd ./server/ watch",
        "watch": "concurrently --kill-others -n \"CLIENT,SERVER\" \"yarn client\" \"yarn server\""
    },
    "devDependencies": {
        "concurrently": "^5.3.0"
    },
    "dependencies": {
        "@types/adm-zip": "^0.4.33",
        "@types/async-busboy": "^0.7.0",
        "@types/http-errors": "^1.8.0",
        "@types/passport-local-mongoose": "^4.0.13",
        "adm-zip": "^0.5.3",
        "async-busboy": "^1.0.1",
        "http-errors": "^1.8.0",
        "passport-local-mongoose": "^6.1.0"
    }
}
